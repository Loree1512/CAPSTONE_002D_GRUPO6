SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Invitaciones de usuarios nuevos: enlace (el administrador copia el enlace) o correo
# (Supabase lo envía; requiere SMTP propio configurado en Supabase).
INVITACION_MODO=enlace

# URL pública del frontend, sin barra final. La invitación vuelve a FRONTEND_URL/acceso.html
# (debe estar en Redirect URLs de Supabase). Vacía: Supabase vuelve a su Site URL.
FRONTEND_URL=

# Versión del modelo de plazo (app/modelos/plazo_<version>.json). Vacía: v1.0-2026-11-01.
# Debe estar registrada en versiones_modelo (migración 009) antes de usarla.
MODELO_PLAZO_VERSION=

# Solo para scripts/actualizar_uf.py (tarea aparte); el backend desplegado no la necesita.
# CMF_API_KEY=

# Auto-registro por POST /autenticacion/registro. Estado final: false.
REGISTRO_PUBLICO=true
