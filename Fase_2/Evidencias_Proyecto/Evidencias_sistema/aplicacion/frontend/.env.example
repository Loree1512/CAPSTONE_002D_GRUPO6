# URL base de la API de BuildCast.
# Mientras no esté desplegada, la API corre local en el equipo del backend.
VITE_API_URL=

# Modo demostración: permite recorrer la plataforma sin API ni usuario real,
# con datos de ejemplo guardados en el navegador.
# Poner false para trabajar contra la API.
VITE_SIMULACION=true

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
